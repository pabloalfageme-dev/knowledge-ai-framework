# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledgeai

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-256-bit-secret

# Access token TTL in seconds (default: 15 minutes)
ACCESS_TOKEN_EXPIRE_SECONDS=900

# Refresh token TTL in days (default: 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Account Lockout ──────────────────────────────────────────────────────────
# Number of consecutive failures before account is locked
LOCKOUT_ATTEMPT_THRESHOLD=5

# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# ── Token Revocation Cache ───────────────────────────────────────────────────
# In-process TTL (seconds) for the user/org status + token_version cache.
# Deactivated users/orgs and incremented token_version are effective within
# this window (existing tokens) or immediately (new login attempts).
REVOCATION_CACHE_TTL_SECONDS=30

# ── Application ──────────────────────────────────────────────────────────────
# development | production | test
APP_ENV=development

# ── Admin Database (kn_admin) ────────────────────────────────────────────────
# set_admin_context() uses SET LOCAL ROLE kn_admin (T008 decision: Option B).
# No separate DATABASE_ADMIN_URL required; kn_admin is granted to kn_app in
# the migration and the role switch is scoped to each super-admin transaction.